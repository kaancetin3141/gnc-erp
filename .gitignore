# ============================================================
# GNC ERP/CRM — .gitignore
# ============================================================

# dependencies
node_modules/
.pnp
.pnp.*

# next.js
.next/
out/
build/

# testing
coverage/

# env files (secrets stay local; example template is committed)
.env
.env.*
!.env.example

# logs
*.log
dev.log
dev.out.log
server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# database — PostgreSQL is the primary DB now.
# Local SQLite leftovers, backups and secrets never enter git.
db/
*.db
*.db-journal
db/backups/
db/.pdf-share-secret
db/.member-secret

# agent/tool artifacts
tool-results/
logs/

# misc
.DS_Store
*.pem
*.tsbuildinfo
next-env.d.ts
.vercel
local-*
.claude
.z-ai-config
test
prompt

# skills
/skills/
