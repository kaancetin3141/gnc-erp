# GNC ERP/CRM — environment template
# Copy to .env and fill in real values.

# PostgreSQL connection string
DATABASE_URL="postgresql://<user>:<password>@127.0.0.1:5432/gnc_erp"

# Optional: secret required by POST /api/seed once the DB has users
# SEED_SECRET="change-me"

# Optional: cron secret shared with mini-services (appointment-reminders)
# CRON_SECRET="change-me"
