// GNC CRM + ERP Süperapp — Prisma Şeması
// SQLite | Multi-tenant (tenant_id) | App-level RBAC

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// M1 — KİMLİK, ŞİRKET, KULLANICI, ROL
// ============================================================

model Tenant {
  id              String   @id @default(cuid())
  name            String
  plan            String   @default("business") // free | business | enterprise
  defaultCurrency String   @default("TRY")
  country         String   @default("TR")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users      User[]
  customers  Customer[]
  leads      Lead[]
  deals      Deal[]
  tasks      Task[]
  activities Activity[]
  mapsSearch MapsSearch[]
  auditLogs  AuditLog[]
  tags       Tag[]
  products   Product[]
  quotes     Quote[]
  invoices   Invoice[]
  orders     Order[]
  settings   TenantSetting[]
  messages   Message[]
  messageTemplates MessageTemplate[]
  productionItems  ProductionItem[]
  cafes            Cafe[]
  markets          Market[]
  expenses         Expense[]
  serviceProviders ServiceProvider[]
  sites            Site[]
  residents        Resident[]
  socialAccounts   SocialAccount[]
  socialPosts      SocialPost[]
  socialInboxMessages SocialInboxMessage[]
  irsaliyeler      Irsaliye[]
  exportDocs       ExportDoc[]
  invoiceTemplate     InvoiceTemplate?
  whatsappMessages WhatsAppMessage[]
}

// Tenant bazlı ayarlar (key-value) — otomasyon threshold, enabled flag vb.
model TenantSetting {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String   // automation.enabled | automation.thresholdDays | notification.email vb.
  value     String   // JSON string veya plain value
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String   @unique
  employeeCode String?  @unique // eşsiz personel kodu: "GNC-001", "KAFE-001"
  name         String
  role         String   @default("rep") // superadmin | admin | manager | rep | readonly | stock
  permissions  String   @default("[]") // JSON array of permission keys
  managerId    String?
  manager      User?    @relation("ManagerHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates User[]   @relation("ManagerHierarchy")
  status       String   @default("active") // active | passive | invited
  phone        String?
  avatarUrl    String?
  title        String? // pozisyon: "Satış Müdürü", "Satış Temsilcisi" vb.
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedCustomers  Customer[]  @relation("CustomerOwner")
  ownedLeads      Lead[]      @relation("LeadOwner")
  ownedDeals      Deal[]      @relation("DealOwner")
  assignedTasks   Task[]      @relation("TaskAssignee")
  activities      Activity[]  @relation("ActivityPerformer")
  notes           Note[]
  mapsSearches    MapsSearch[]
  auditLogs       AuditLog[]  @relation("AuditActor")
  sentMessages    Message[]   @relation("MessageSender")
  receivedMessages Message[]  @relation("MessageReceiver")
  socialPosts      SocialPost[]
}

// Şirket içi mesajlaşma (1-1 ve broadcast)
model Message {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String?
  receiver    User?    @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: SetNull)
  content     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([tenantId, receiverId, isRead])
  @@index([tenantId, senderId, createdAt])
}

// ============================================================
// M2 — MÜŞTERİ PORTFÖYÜ
// ============================================================

model Customer {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  sector        String    @default("Diğer")
  segment       String    @default("standart") // vip | kurumsal | standart | potansiyel
  ownerId       String?
  owner         User?      @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  source        String    @default("manuel") // manuel | google_maps | referral | website | event
  address       String?
  city          String?
  district      String?  // ilçe
  country       String    @default("TR")
  lat           Float?
  lng           Float?
  placeId       String?
  phone         String?
  email         String?
  web           String?
  taxNumber     String?
  logo          String?  // logo/photo (base64 data URL or external URL)
  customerType  String   @default("musteri") // kafe | dis_ticaret | musteri_hizmetleri | musteri
  status        String    @default("aktif") // aktif | pasif | potansiyel | kaybedildi
  tags          String    @default("[]") // JSON array of tag names
  kvkkConsent   Boolean   @default(false)
  kvkkConsentAt DateTime?
  annualRevenue Float?
  employeeCount Int?
  lastActivityAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  contacts    Contact[]
  activities  Activity[]
  notes       Note[]
  deals       Deal[]
  tasks       Task[]
  attachments Attachment[]
  leads       Lead[]      @relation("LeadConvertedTo")
  quotes      Quote[]
  invoices    Invoice[]
  orders      Order[]
  irsaliyeler Irsaliye[]
  exportDocs  ExportDoc[]
  whatsappMessages WhatsAppMessage[]
}

// ============================================================
// WhatsApp Mesaj Merkezi — tüm giden WhatsApp mesajlarının
// merkezi kaydı (hatırlatma, teklif gönderimi, randevu onayı vb.)
// Durum akışı: kuyrukta → (wa.me açıldı) → gonderildi | iptal
// ============================================================
model WhatsAppMessage {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName String?  // müşteri silinse de mesaj geçmişi kalsın
  phone       String    // E.164 hedef numara
  title       String?   // kısa başlık: "Ödeme Hatırlatma — FAT-2026-003"
  body        String    // tam mesaj metni
  contextType String    @default("serbest") // fatura_hatirlatma | teklif_gonderim | proforma_gonderim | randevu_onay | aidat_hatirlatma | serbest
  contextId   String?   // ilgili kaydın id'si (invoice/quote/appointment)
  contextNo   String?   // insan-okur referans: FAT-2026-003, TKL-2026-001
  amount      Float?
  currency    String?
  status      String    @default("kuyrukta") // kuyrukta | gonderildi | iptal
  channel     String    @default("wa.me")    // wa.me (business-api ileride)
  sentAt      DateTime?
  createdById String?
  createdByName String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, contextType])
  @@index([customerId])
}

model Contact {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name        String
  position    String?
  email       String?
  phone       String?
  photo       String?  // kişi fotoğrafı (base64 or URL)
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// M3 — LEADS (Maps'ten gelen potansiyel müşteriler)
// ============================================================

model Lead {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  placeId             String?
  category            String?
  address             String?
  city                String?
  district            String?  // ilçe
  country             String    @default("TR")
  lat                 Float?
  lng                 Float?
  phone               String?
  web                 String?
  email               String?
  rating              Float?
  reviewCount         Int?
  ownerId             String?
  owner               User?      @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  source              String    @default("google_maps")
  status              String    @default("yeni") // yeni | iletisim | nitelikli | donustu | kaybedildi
  convertedCustomerId String?
  convertedCustomer   Customer? @relation("LeadConvertedTo", fields: [convertedCustomerId], references: [id], onDelete: SetNull)
  notes               String    @default("[]") // JSON
  mapsSearchId        String?
  mapsSearch          MapsSearch? @relation(fields: [mapsSearchId], references: [id], onDelete: SetNull)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  activities Activity[]
}

model MapsSearch {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  query       String
  city        String?
  country     String   @default("TR")
  radius      Int?
  resultCount Int      @default(0)
  importedCount Int    @default(0)
  createdAt   DateTime @default(now())

  leads Lead[]
}

// ============================================================
// M4 — FIRSAT / PIPELINE
// ============================================================

model Deal {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title            String
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  value            Float     @default(0)
  currency         String    @default("TRY")
  stage            String    @default("yeni") // yeni | iletisim | teklif | muzakere | kazanıldı | kaybedildi
  probability      Int       @default(10)
  expectedCloseDate DateTime?
  ownerId          String?
  owner            User?      @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lossReason       String?
  lossNote         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  activities Activity[]
}

// ============================================================
// ORTAK — AKTİVİTE, NOT, GÖREV, EK
// ============================================================

model Activity {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  type        String    // arama | toplanti | email | whatsapp | not | ziyaret | gorev
  subject     String
  detail      String?
  date        DateTime  @default(now())
  durationMin Int       @default(0)
  outcome     String?   // basarili | basarisiz | ertelendi | callback
  userId      String?
  user        User?     @relation("ActivityPerformer", fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
}

model Note {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  content     String
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  dueDate       DateTime
  assigneeId    String?
  assignee      User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  priority      String    @default("orta") // dusuk | orta | yuksek | acil
  reminderTime  String?   // "09:00"
  status        String    @default("acik") // acik | tamamlandi | iptal
  autoGenerated Boolean   @default(false)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Attachment {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fileName    String
  fileType    String
  fileSize    Int
  url         String
  uploadedBy  String?
  createdAt   DateTime @default(now())
}

model Tag {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("gray")
  createdAt DateTime @default(now())
}

// ============================================================
// GÜVENLİK — AUDIT LOG
// ============================================================

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String   // create | update | delete | login | export
  entity    String   // customer | deal | user | ...
  entityId  String?
  before    String?  // JSON
  after     String?  // JSON
  ip        String?
  createdAt DateTime @default(now())
}

// ============================================================
// FAZ 2 — ERP-LITE (ŞEMA HAZIRLIĞI, UI YOK)
// ============================================================

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  sku         String?
  description String?
  price       Float    @default(0)
  currency    String   @default("TRY")
  taxRate     Float    @default(20)
  stock       Int      @default(0)
  minStock    Int      @default(0)
  unit        String   @default("adet")
  category    String?
  photo       String?  // ürün fotoğrafı (base64 or URL)
  // Ağırlık & ambalaj (F4-PRODUCT-WEIGHT-PALET)
  weight          Float?   // net ağırlık — dahili olarak her zaman kg cinsinden saklanır
  weightUnit      String   @default("kg") // gr | kg | ton (kullanıcıdan alınan birim; değer kg'ya çevrilerek saklanır)
  packagingWeight Float?   // ambalaj ağırlığı (kg, birim başına)
  packagingType   String?  // karton | plastik | ahsap | metal | other
  paletType       String?  // tahta | plastik | tek_kullanimlik | eur_pallet | other
  paletCount      Int?     // palet adedi
  color           String?  // ürün rengi (serbest metin — satin altın, kirmizi, vb.)
  carrier         String?  // yurtici | aras | mng | ptt | ups | fedex | dhl | other
  trackingNumber  String?  // kargo takip no
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockMovements StockMovement[]
  quoteLines     QuoteLine[]
  invoiceLines  InvoiceLine[]
  productionItems ProductionItem[]
  shelfItems     ShelfItem[]
  barcodes       Barcode[]
  stockCountItems StockCountItem[]
  marketSaleItems MarketSaleItem[]
  purchaseItems   PurchaseItem[]
  irsaliyeLines   IrsaliyeLine[]
}

model StockMovement {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int
  type        String   // giris | cikis | duzeltme | transfer
  reason      String?
  refType     String?  // quote | invoice | manual
  refId       String?
  createdAt   DateTime @default(now())
}

model Quote {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id])
  number       String
  status       String    @default("taslak") // taslak | gonderildi | onaylandi | reddedildi | faturalandi
  isProforma   Boolean   @default(false)
  subtotal     Float     @default(0)
  taxTotal     Float     @default(0)
  total        Float     @default(0)
  currency     String    @default("TRY")
  issueDate    DateTime  @default(now())
  validUntil   DateTime?
  invoiceId    String?
  invoice      Invoice?  @relation("QuoteInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lines QuoteLine[]
  order Order?
}

model QuoteLine {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  qty         Float   @default(1)
  unitPrice   Float   @default(0)
  taxRate     Float   @default(20)
  lineTotal   Float   @default(0)
  // Ağırlık & varyant (F4-PRODUCT-WEIGHT-PALET)
  weightPerUnit Float?  // birim başına net ağırlık (kg)
  weightUnit    String? // gr | kg | ton (görüntüleme birimi)
  totalWeight   Float?  // hesaplanan toplam net ağırlık (kg) = qty × weightPerUnit
  color         String? // renk (serbest metin — satin altın, kirmizi, vb.)
}

model Invoice {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id])
  number          String
  status          String    @default("odeme_bekliyor") // odeme_bekliyor | odendi | gecikti | iptal
  subtotal        Float     @default(0)
  taxTotal        Float     @default(0)
  total           Float     @default(0)
  currency        String    @default("TRY")
  issueDate       DateTime  @default(now())
  dueDate         DateTime?
  paidDate        DateTime?
  // Çeki listesi (packing list)
  packingListNo   String?
  packingListDate DateTime?
  // İrsaliye (dispatch note)
  dispatchNo      String?
  dispatchDate    DateTime?
  // Sipariş bağlantısı
  orderId         String?    @unique
  order           Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lines InvoiceLine[]
  fromQuotes Quote[] @relation("QuoteInvoice")
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  qty         Float    @default(1)
  unitPrice   Float    @default(0)
  taxRate     Float    @default(20)
  lineTotal   Float    @default(0)
  // Ağırlık & varyant (F4-PRODUCT-WEIGHT-PALET)
  weightPerUnit Float?  // birim başına net ağırlık (kg)
  weightUnit    String? // gr | kg | ton (görüntüleme birimi)
  totalWeight   Float?  // hesaplanan toplam net ağırlık (kg) = qty × weightPerUnit
  color         String? // renk varyantı (serbest metin — satin altın, kirmizi, vb.)
}

// ============================================================
// FAZ 3 — PROFORMA & SIPARIŞ TAKİP
// ============================================================

// Sipariş (Order) — onaylanan proforma/tekliften veya manuel oluşturulur.
// Sipariş takibi: hazirlaniyor → onaylandi → uretimde → sevk_yapildi → teslim_edildi | iptal
model Order {
  id               String     @id @default(cuid())
  tenantId         String
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer   @relation(fields: [customerId], references: [id])
  quoteId          String?    @unique
  quote            Quote?     @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  number           String
  status           String     @default("hazirlaniyor") // hazirlaniyor | onaylandi | uretimde | sevk_yapildi | teslim_edildi | iptal
  totalAmount      Float      @default(0)
  currency         String     @default("TRY")
  orderDate        DateTime   @default(now())
  expectedDelivery DateTime?
  deliveredAt      DateTime?
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  trackingSteps OrderTrackingStep[]
  productionItems ProductionItem[]
  invoice      Invoice?
  irsaliyeler  Irsaliye[]
  exportDocs   ExportDoc[]
}

// ============================================================
// İHRACAT BELGELERİ — Dış ticaret evrakları
// ============================================================
// Belge türleri ve numara formatları (tenant + yıl bazlı):
//   atr        → ATR-2026-001   ATR Dolaşım Belgesi (AB ülkeleri)
//   eur1       → EUR1-2026-001  EUR.1 Dolaşım Belgesi (STA ülkeleri)
//   mense      → MSH-2026-001   Menşe Şahadetnamesi (Certificate of Origin)
//   gumruk     → GBE-2026-001   İhracat/Gümrük Beyannamesi
//   konsimento → KNS-2026-001   Konşimento (Bill of Lading)
//   sigorta    → SIG-2026-001   Sigorta Poliçesi / Sertifikası
// Durum: taslak | hazir | imzalandi | gonderildi | iptal
model ExportDoc {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  type        String   // atr | eur1 | mense | gumruk | konsimento | sigorta
  number      String
  status      String   @default("hazir")
  issueDate   DateTime @default(now())
  // Dış ticaret bilgileri
  transportMode     String?  // karayolu | denizyolu | havayolu | demiryolu
  incoterms         String?  // EXW | FCA | FOB | CFR | CIF | CPT | CIP | DAP | DPU | DDP
  destinationCountry String?
  portOfLoading     String?
  portOfDischarge   String?
  vesselName        String?  // denizyolu — gemi adı
  containerNo       String?  // konteyner no
  vehiclePlate      String?  // karayolu — araç plakası
  carrierName       String?  // taşıyıcı firma
  insuranceCompany  String?  // sigorta şirketi
  policyAmount      Float?   // sigorta tutarı
  policyCurrency    String?
  notes             String?
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, number])
  @@index([tenantId, type])
  @@index([tenantId, orderId])
  @@index([tenantId, status])
}

// Sipariş takip adımı — her durum değişiminde otomatik ya da manuel eklenir
model OrderTrackingStep {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  step      String   // hazirlaniyor | onaylandi | uretimde | sevk_yapildi | teslim_edildi | iptal
  note      String?
  userId    String?
  createdAt DateTime @default(now())
}

// ============================================================
// HAZIR YAZI ŞABLONLARI (#4) — WhatsApp/E-posta için düzenlenebilir promptlar
// ============================================================
model MessageTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String   // şablon adı: "Hoş geldin mesajı", "Teklif takip"
  type        String   @default("whatsapp") // whatsapp | email | sms
  category    String   @default("genel") // genel | satis | takip | teklif | tesekkur
  subject     String?  // email için konu
  content     String   // şablon metni ({{musteri}}, {{temsilci}} gibi değişkenler)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, type])
}

// ============================================================
// ÜRETİM LİSTESİ — Depo elemanları için sipariş kalemleri üretim takibi (#2)
// ============================================================
model ProductionItem {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  qty         Float    @default(1)
  status      String   @default("bekliyor") // bekliyor | uretiliyor | uretildi
  producedAt  DateTime?
  producedBy  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status])
}

// ============================================================
// IRSALİYE (DISPATCH NOTE) — Sevk irsaliyesi, ağırlık takibi, palet
// ============================================================
// Numara formatı: IRS-2026-001, IRS-2026-002 (yıl + tenant bazlı sıra)
// Durum: taslak | hazir | sevk_edildi | teslim_edildi | iptal
// Ağırlık hesabı:
//   totalNetWeight       = sum(line.weightPerUnit * line.qty)
//   totalPackagingWeight = sum(product.packagingWeight * line.qty) (opsiyonel)
//   palletWeight         = kullanıcı girişi (varsayılan 20 kg)
//   totalGrossWeight     = net + packaging + pallet
model Irsaliye {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId            String?
  order              Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerId         String
  customer           Customer @relation(fields: [customerId], references: [id])
  number             String   // IRS-2026-001
  date               DateTime @default(now())
  status             String   @default("taslak") // taslak | hazir | sevk_edildi | teslim_edildi | iptal
  // Ağırlık takibi
  totalNetWeight         Float?   // sum of line.weightPerUnit * line.qty
  totalPackagingWeight    Float?   // sum of product.packagingWeight * line.qty
  palletWeight            Float?   // user-entered pallet weight (default 20 kg)
  totalGrossWeight        Float?   // net + packaging + pallet
  palletCount             Int?
  palletType              String?  // tahta | plastik | tek_kullanilik | eur_pallet | other
  // Sevkiyat bilgileri
  shippingAddress         String?
  carrier                 String?  // yurtici | aras | mng | ptt | ups | fedex | dhl | other
  trackingNo              String?
  // Notlar
  notes                   String?
  createdById             String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  deliveredAt             DateTime?

  lines IrsaliyeLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

// İrsaliye kalemleri — ürün, miktar, birim ağırlık, toplam ağırlık
model IrsaliyeLine {
  id             String   @id @default(cuid())
  irsaliyeId     String
  irsaliye       Irsaliye @relation(fields: [irsaliyeId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description    String
  qty             Float    @default(1)
  unit            String   @default("adet")
  // Ağırlık (kg)
  weightPerUnit   Float?   // kg / birim
  totalWeight     Float?   // qty * weightPerUnit
  notes           String?

  @@index([irsaliyeId])
}

// ============================================================
// KAFE ERP — Masa, Menü, Sipariş, Ödeme, Reçete
// ============================================================

model Cafe {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  address     String?
  phone       String?
  tableCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tables       CafeTable[]
  menuCategories MenuCategory[]
  cafeOrders   CafeOrder[]
}

// Masa — kuş bakışı konum (x, y百分比), şekil, kapasite
model CafeTable {
  id          String   @id @default(cuid())
  cafeId      String
  cafe        Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  number      String   // masa numarası: "M1", "M2", "Teras-1"
  shape       String   @default("square") // square | round | rectangle
  x           Float    @default(50) // yüzde 0-100 (kuş bakışı X)
  y           Float    @default(50) // yüzde 0-100 (kuş bakışı Y)
  width       Float    @default(10) // yüzde
  height      Float    @default(10) // yüzde
  capacity    Int      @default(4)
  status      String   @default("bos") // bos | dolu | rezerve | siparis
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      CafeOrder[]
}

// Menü kategorisi (İçecekler, Ana Yemekler, Tatlılar, etc.)
model MenuCategory {
  id          String   @id @default(cuid())
  cafeId      String
  cafe        Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  name        String
  icon        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  items       MenuItem[]
}

// Menü kalemi (ürün + fiyat + reçete)
model MenuItem {
  id          String   @id @default(cuid())
  categoryId  String
  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float    @default(0)
  currency    String   @default("TRY")
  photo       String?
  isAvailable Boolean  @default(true)
  prepTime    Int      @default(10) // hazırlık süresi (dk)
  station     String   @default("kitchen") // bar | kitchen | dessert
  recipe      String?  // reçete/metin (hazırlama talimatları)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  CafeOrderItem[]
}

// Kafe siparişi (masa bazlı)
model CafeOrder {
  id          String   @id @default(cuid())
  cafeId      String
  cafe        Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  tableId     String?
  table       CafeTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  number      String   // sipariş no: "S-001"
  status      String   @default("acik") // acik | hazirlaniyor | hazir | odendi | iptal
  type        String   @default("dine_in") // dine_in | takeaway | delivery
  customerName String? // takeaway/delivery için
  subtotal    Float    @default(0)
  taxTotal    Float    @default(0)
  total       Float    @default(0)
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       CafeOrderItem[]
  payments    CafePayment[]
}

// Sipariş kalemi
model CafeOrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       CafeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId  String?
  menuItem    MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  name        String   // snapshot
  qty         Int      @default(1)
  unitPrice   Float    @default(0) // snapshot
  status      String   @default("bekliyor") // bekliyor | hazirlaniyor | hazir | servis_edildi
  notes       String?  // özel istek: "az şekerli", "soğuk"
  station     String   @default("kitchen") // bar | kitchen | dessert
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Ödeme
model CafePayment {
  id          String   @id @default(cuid())
  orderId     String
  order       CafeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount      Float
  method      String   @default("cash") // cash | card | online
  status      String   @default("tamamlandi") // tamamlandi | iade
  createdAt   DateTime @default(now())
}

// ============================================================
// MARKET ERP — Stok, Kasa, Barkod, Satış, Vardiya, İade
// ============================================================

model Market {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  address     String?
  phone       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shelves     Shelf[]
  posShifts   PosShift[]
  sales       MarketSale[]
  stockCounts StockCount[]
  barcodes    Barcode[]
  purchases   Purchase[]
}

// Raf — ürünlerin raftaki konumu
model Shelf {
  id          String   @id @default(cuid())
  marketId    String
  market      Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  code        String   // raf kodu: "A1", "B-3"
  name        String?
  aisle       String?  // koridor
  createdAt   DateTime @default(now())

  items       ShelfItem[]
}

model ShelfItem {
  id          String   @id @default(cuid())
  shelfId     String
  shelf       Shelf    @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty         Int      @default(0)  // raftaki adet
  minDisplayQty Int    @default(2)  // minimum gösterim adedi
}

// Barkod — ürünün barkodları (bir ürünün birden fazla barkodu olabilir)
model Barcode {
  id          String   @id @default(cuid())
  marketId    String?
  market      Market?  @relation(fields: [marketId], references: [id], onDelete: SetNull)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  code        String   @unique  // barkod numarası
  type        String   @default("ean13") // ean13 | upc | custom
  createdAt   DateTime @default(now())
}

// Stok Sayım — periyodik envanter sayımı
model StockCount {
  id          String   @id @default(cuid())
  marketId    String
  market      Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  number      String   // sayım no: "SAY-001"
  status      String   @default("taslak") // taslak | tamamlandi | iptal
  startDate   DateTime @default(now())
  endDate     DateTime?
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       StockCountItem[]
}

model StockCountItem {
  id            String   @id @default(cuid())
  stockCountId  String
  stockCount    StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  expectedQty   Int      @default(0)  // sistemdeki beklenen miktar
  countedQty    Int?     // sayılan miktar
  difference    Int?     // fark (counted - expected)
  notes         String?
}

// POS Vardiya — kasa açılış/kapanış
model PosShift {
  id          String   @id @default(cuid())
  marketId    String
  market      Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  userId      String   // kasiyer
  number      String   // vardiya no: "V-001"
  status      String   @default("acik") // acik | kapali
  openingCash Float    @default(0)  // açılış nakiti
  closingCash Float?   // kapanış nakiti
  expectedCash Float?  // beklenen nakit (satışlardan hesaplanan)
  difference  Float?   // nakit farkı
  openingTime DateTime @default(now())
  closingTime DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sales       MarketSale[]
}

// Market Satış — POS satış fişi
model MarketSale {
  id          String   @id @default(cuid())
  marketId    String
  market      Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  posShiftId  String?
  posShift    PosShift? @relation(fields: [posShiftId], references: [id], onDelete: SetNull)
  number      String   // fiş no: "FIS-001"
  type        String   @default("satis") // satis | iade
  status      String   @default("tamamlandi") // tamamlandi | iptal
  subtotal    Float    @default(0)
  taxTotal    Float    @default(0)
  discount    Float    @default(0)
  total       Float    @default(0)
  paymentMethod String @default("cash") // cash | card | mixed
  cashAmount  Float    @default(0)
  cardAmount  Float    @default(0)
  customerName String? // müşteri adı (opsiyonel)
  userId      String?  // kasiyer
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       MarketSaleItem[]
  returns     MarketReturn[]
}

// Satış kalemi
model MarketSaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        MarketSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  barcode     String?  // okunan barkod
  name        String   // snapshot
  qty         Float    @default(1)
  unitPrice   Float    @default(0)
  taxRate     Float    @default(20)
  discount    Float    @default(0)
  lineTotal   Float    @default(0)
}

// İade — satış iadesi
model MarketReturn {
  id          String   @id @default(cuid())
  saleId      String   // orijinal satış
  sale        MarketSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  reason      String   // iade sebebi
  totalAmount Float    @default(0)
  status      String   @default("tamamlandi") // tamamlandi | reddedildi
  userId      String?
  createdAt   DateTime @default(now())
}

// Mal Kabul — tedarikten gelen ürün kabul
model Purchase {
  id          String   @id @default(cuid())
  marketId    String
  market      Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  number      String   // mal kabul no: "MK-001"
  supplier    String?  // tedarikçi adı
  invoiceNo   String?  // irsaliye/fatura no
  status      String   @default("bekliyor") // bekliyor | kabul_edildi | reddedildi
  totalAmount Float    @default(0)
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       PurchaseItem[]
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  barcode     String?
  name        String
  qty         Float    @default(1)
  unitPrice   Float    @default(0)
  lineTotal   Float    @default(0)
  accepted    Boolean  @default(false)
}

// ============================================================
// GİDER YÖNETİMİ (#1)
// ============================================================
model Expense {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    String   // kira | personel | fatura | malzeme | pazarlama | sigorta | vergi | diger
  description String
  amount      Float
  currency    String   @default("TRY")
  date        DateTime @default(now())
  recurring   String?  // null | monthly | weekly | yearly
  vendor      String?  // tedarikçi/firma
  invoiceNo   String?
  status      String   @default("odendi") // odendi | beklemedi | odeme_yapilmedi
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, date])
  @@index([tenantId, category])
}

// ============================================================
// RANDEVU SİSTEMİ (#5) — Berber/Kuaför/Dişçi/Güzellik
// ============================================================
model ServiceProvider {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String   // işletme adı: "Kuaför X"
  slug        String?  @unique // URL-friendly name — auto-generated from name (e.g. "Şık Kuaför" → "sik-kuafor")
  type        String   @default("berber") // berber | kuafor | disci | guzellik | spa | dovme
  address     String?
  city        String?
  district    String?
  phone       String?
  email       String?
  photo       String?
  workingHours String  @default("{}") // JSON: { "mon": {"start":"09:00","end":"18:00"}, ... }
  autoApprove  Boolean @default(true) // randevular otomatik onaylansın mı? (kapalıysa müşteri onay bekler)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff       Staff[]
  services    Service[]
  appointments Appointment[]
  customers   AppointmentCustomer[]
  timeOffs    StaffTimeOff[]
}

// Personel (berber, kuaför, diş hekimi, vs.)
model Staff {
  id          String   @id @default(cuid())
  providerId  String
  provider    ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name        String
  title       String?  // "Usta Berber", "Diş Hekimi"
  photo       String?
  phone       String?
  bio         String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  appointments Appointment[]
  staffServices StaffService[]
  timeOffs     StaffTimeOff[]
}

// Personel izin günleri — tam gün veya saat aralıklı izin kaydı.
// İzinli personel bu aralıkta randevu alamaz (manuel + public booking + takvim taşıma dahil).
model StaffTimeOff {
  id          String   @id @default(cuid())
  providerId  String
  provider    ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date        DateTime // günün başlangıcı (00:00)
  isFullDay   Boolean  @default(true)
  startTime   String?  // "HH:MM" — isFullDay=false ise zorunlu
  endTime     String?  // "HH:MM"
  reason      String?  // "Yıllık izin", "Hastalık", "Eğitim" ...
  createdAt   DateTime @default(now())

  @@index([providerId, date])
  @@index([staffId, date])
}

// Hizmet (saç kesimi, saç boyama, diş temizleme, vs.)
model Service {
  id          String   @id @default(cuid())
  providerId  String
  provider    ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name        String   // "Saç Kesimi", "Saç Boyama"
  description String?
  duration    Int      @default(30) // dakika
  price       Float    @default(0)
  currency    String   @default("TRY")
  category    String?  // "Saç", "Cilt", "Diş"
  photo       String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  appointments Appointment[]
  staffServices StaffService[]
}

// Personel-Hizmet bağlantısı (hangi personel hangi hizmeti verebilir)
model StaffService {
  id          String   @id @default(cuid())
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
}

// Randevu
model Appointment {
  id          String   @id @default(cuid())
  providerId  String
  provider    ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    AppointmentCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  staffId     String?
  staff       Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  customerName String
  customerPhone String
  customerEmail String?
  customerNote String?
  date        DateTime // randevu tarihi/saati
  endTime     DateTime? // bitiş (date + service.duration)
  status      String   @default("beklemede") // beklemede | onaylandi | reddedildi | tamamlandi | iptal | gelmedi
  price       Float    @default(0)
  notes       String?  // internal notlar
  source      String   @default("web") // web | phone | walk_in
  reminderSent Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([providerId, date])
  @@index([staffId, date])
  @@index([status])
  @@index([customerId])
}

// Kalıcı müşteri kayıt defteri — işletme bazlı müşteri profilleri.
// Randevu oluşturulduğunda telefonla otomatik eşleştirilir/oluşturulur.
model AppointmentCustomer {
  id          String   @id @default(cuid())
  providerId  String
  provider    ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  phoneDigits String   // normalleştirilmiş rakamlar (05321234567) — eşleştirme anahtarı
  email       String?
  address     String?
  notes       String?  // kalıcı not: tercihler, alerji, VIP bilgisi vb.
  tags        String?  // JSON: ["VIP","Sabit müşteri"]
  birthday    String?  // "05-23" (MM-DD) — yıllık hatırlatma için
  isBlocked   Boolean  @default(false) // sorunlu müşteri — randevu almaz
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]

  @@unique([providerId, phoneDigits])
  @@index([providerId, name])
}

// ============================================================
// SİTE YÖNETİMİ — Aidat Takip, Site Sakini, Kapıcı, Şikayet
// ============================================================

model Site {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String   // site adı: "Park Sitesi"
  address     String?
  city        String?
  district    String?
  phone       String?
  email       String?
  managerName String?  // yönetici adı
  dueDay      Int      @default(5) // aidat ödeme günü (her ay)
  defaultDueAmount Float @default(0) // varsayılan aidat tutarı
  currency    String   @default("TRY")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  blocks      Block[]
  apartments  Apartment[]
  siteStaff   SiteStaff[]
  dues        Dues[]
  announcements Announcement[]
  complaints  Complaint[]
}

// Blok (A Blok, B Blok, vb.)
model Block {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name        String   // "A Blok", "B Blok"
  floors      Int      @default(5)
  createdAt   DateTime @default(now())

  apartments  Apartment[]
}

// Daire
model Apartment {
  id          String   @id @default(cuid())
  blockId     String
  block       Block    @relation(fields: [blockId], references: [id], onDelete: Cascade)
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  number      String   // daire no: "1", "2A", "12"
  floor       Int?
  type        String   @default("daire") // daire | dukkan | depo
  area        Float?   // m²
  residentId  String?  @unique // sakin (boşsa müstakil)
  createdAt   DateTime @default(now())

  resident    Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)
  dues        Dues[]
}

// Site sakini (kiracı veya mal sahibi)
model Resident {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId      String
  name        String
  email       String?
  phone       String?  // WhatsApp için
  password    String?  // site sakini girişi için (basit hash)
  type        String   @default("mal_sahibi") // mal_sahibi | kiraci
  isOwner     Boolean  @default(true)
  isActive    Boolean  @default(true)
  tcKimlikNo  String?  // TC kimlik numarası (yalnızca mal sahipleri için)
  notes       String?  // genel notlar
  moveInDate  DateTime? // taşınma tarihi (kiracı için)
  leaseEndDate DateTime? // kira sözleşmesi bitişi (kiracı için)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  apartment   Apartment?
  dues        Dues[]
  complaints  Complaint[]
  messages    ResidentMessage[]
}

// Aidat
model Dues {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  residentId  String?
  resident    Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)
  month       Int      // 1-12
  year        Int
  amount      Float
  currency    String   @default("TRY")
  dueDate     DateTime // ödeme son tarihi
  status      String   @default("odenmedi") // odenmedi | odendi | gecikti
  paidDate    DateTime?
  paidAmount  Float?
  paymentMethod String? // cash | bank | online
  lateFee     Float    @default(0) // gecikme zammı (uygulanmışsa sıfırdan büyük)
  lateFeeAppliedAt DateTime? // gecikme zammının uygulandığı tarih
  reminderSent Boolean @default(false)
  reminderSentAt DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([siteId, year, month])
  @@index([status])
}

// Site personeli (kapıcı, güvenlik, temizlik)
model SiteStaff {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name        String
  role        String   @default("kapici") // kapici | guvenlik | temizlik | bahcivan | teknik
  phone       String?
  photo       String?
  salary      Float?
  startDate   DateTime?
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
}

// Duyuru
model Announcement {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  title       String
  content     String
  type        String   @default("genel") // genel | acil | aidat | bakim | etkinlik
  isPinned    Boolean  @default(false)
  publishDate DateTime @default(now())
  expiryDate  DateTime?
  createdById String?
  createdAt   DateTime @default(now())
}

// Şikayet / Talep
model Complaint {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  residentId  String?
  resident    Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)
  title       String
  description String
  category    String   @default("diger") // su | elektrik | asansor | guvenlik | temizlik | gurultu | park | diger
  status      String   @default("acik") // acik | inceleniyor | cozuldu | reddedildi
  priority    String   @default("normal") // dusuk | normal | yuksek | acil
  response    String?  // yönetim cevabı
  respondedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Sakin mesajları (yönetime)
model ResidentMessage {
  id          String   @id @default(cuid())
  residentId  String
  resident    Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  subject     String
  content     String
  response    String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// SOSYAL MEDYA YÖNETİMİ — Çoklu platform tek panelden
// Platformlar: Twitter/X, Facebook, Instagram, LinkedIn, YouTube,
// TikTok, WhatsApp Business, Telegram, Pinterest, Reddit, Bluesky
// ============================================================

// Bağlı sosyal medya hesabı (her platform için ayrı kayıt)
model SocialAccount {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platform     String   // twitter | facebook | instagram | linkedin | youtube | tiktok | whatsapp | telegram | pinterest | reddit | bluesky
  handle       String   // @username veya sayfa adı
  displayName  String?
  avatarUrl    String?
  bio          String?
  // Token — gerçek hesap bağlantısı (production'da encrypted vault)
  accessToken  String?
  refreshToken String?
  tokenExpiresAt DateTime?
  // OAuth client credentials (kullanıcının kendi app'i)
  apiKey       String?  // OAuth client_id / app key
  apiSecret    String?  // OAuth client_secret / app secret
  username     String?  // platform-specific: e-posta, bot username, etc.
  // Bağlantı tipi
  authMethod   String   @default("mock") // mock | oauth | manual_token
  scopes       String?  // JSON array — verilen yetkiler
  profileData  String?  // JSON — /me endpoint'inden gelen profil snapshot
  // Platform metadatası
  followerCount Int     @default(0)
  followingCount Int   @default(0)
  postCount    Int     @default(0)
  isVerified   Boolean @default(false)
  isActive     Boolean @default(true)
  // Yönetim
  connectedAt DateTime @default(now())
  lastSyncedAt DateTime?
  disconnectedAt DateTime?

  posts      SocialPostTarget[]
  inboxMessages SocialInboxMessage[]

  @@unique([tenantId, platform, handle])
  @@index([tenantId, platform])
}

// Oluşturulan gönderi — bir veya birden fazla platforma yayınlanabilir
model SocialPost {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authorId     String
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  // İçerik
  content      String   // ana metin
  mediaUrls    String   @default("[]") // JSON array: [{url, type, alt}]
  mediaType    String   @default("text") // text | image | video | link | carousel
  linkUrl      String?
  linkPreview  String?  // JSON: {title, description, image}
  // Etiketler
  hashtags     String?  // JSON array
  mentions     String?  // JSON array
  // Hedef platformlar
  platforms    String   @default("[]") // JSON array: ["twitter","instagram",...]
  perPlatformContent String? @default("{}") // JSON: {twitter:"...", instagram:"..."}
  // Zamanlama
  status       String   @default("taslak") // taslak | zamanlandi | yayinlandi | basarisiz | iptal
  scheduledAt  DateTime?
  publishedAt  DateTime?
  // Hedef kitle / kampanya (opsiyonel)
  campaignName String?
  // Yorumlar
  notes        String?

  targets     SocialPostTarget[]
  analytics   SocialPostAnalytics[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, scheduledAt])
  @@index([authorId])
}

// Her platform için yayın sonucu — bir post N platforma yayınlanır
model SocialPostTarget {
  id           String   @id @default(cuid())
  postId       String
  post         SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  accountId    String
  account      SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform     String   // denormalized — hızlı filtreleme için
  externalId   String?  // platform'taki gerçek post ID (mock)
  externalUrl  String?  // platform'daki gerçek post URL
  status       String   @default("bekliyor") // beklemede | yayinlandi | basarisiz | silindi
  errorMessage String?
  publishedAt  DateTime?
  // Anlık metrik snapshot'ı (her sync'te güncellenir)
  likes        Int      @default(0)
  comments     Int      @default(0)
  shares       Int      @default(0)
  views        Int      @default(0)
  reach        Int      @default(0)
  impressions  Int      @default(0)
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([postId, accountId])
  @@index([status])
}

// Birleşik gelen kutusu — DM, yorum, mention, değerlendirme
model SocialInboxMessage {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountId    String
  account      SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform     String   // denormalized
  // Gönderen bilgisi
  senderName   String
  senderHandle String?
  senderAvatar String?
  // Mesaj
  type         String   @default("dm") // dm | comment | mention | review | story_reply
  content      String
  mediaUrls    String?  // JSON array
  // Konuşma / üst mesaj
  parentId     String?
  // Hedef post (yorum ise)
  postExternalId String?
  postUrl       String?
  // Yönetim
  isRead       Boolean  @default(false)
  isReplied    Boolean  @default(false)
  replyText    String?
  repliedAt    DateTime?
  // Öncelik
  priority     String   @default("normal") // dusuk | normal | yuksek | acil
  // Etiketler
  tags         String?  // JSON array
  // Zaman
  externalCreatedAt DateTime? // platformdaki gerçek zaman
  receivedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, isRead])
  @@index([accountId, receivedAt])
}

// Zaman serisi metrikleri — her post için günlük snapshot
model SocialPostAnalytics {
  id           String   @id @default(cuid())
  postId       String
  post         SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  targetId     String?
  platform     String   // "all" veya tek platform
  date         DateTime // snapshot tarihi
  // Etkileşim metrikleri
  likes        Int      @default(0)
  comments     Int      @default(0)
  shares       Int      @default(0)
  views        Int      @default(0)
  reach        Int      @default(0)
  impressions  Int      @default(0)
  profileClicks Int     @default(0)
  // Demografik (JSON: {age:{}, gender:{}, geo:{}})
  demographics String?
  createdAt    DateTime @default(now())

  @@index([postId, date])
  @@index([platform, date])
}

// ============================================================
// FATURA ŞABLONU — Şirket bazlı özelleştirilebilir fatura/irsaliye/çeki listesi şablonu
// Logo, renk, font, footer bilgileri, banka bilgileri, imza
// ============================================================

model InvoiceTemplate {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Logo
  logoUrl      String?  // base64 veya URL
  logoPosition String   @default("top-left") // top-left | top-right | top-center | none
  // Renkler
  primaryColor String   @default("#10b981") // başlık, vurgular
  accentColor  String   @default("#0d9488") // tablo başlık, ikincil
  textColor    String   @default("#000000")
  // Font
  fontFamily   String   @default("Arial, sans-serif")
  fontSize     Int      @default(12)
  // İçerik
  headerText   String?  // "Bu fatura elektronik olarak düzenlenmiştir"
  footerText   String?  // "Ödeme 30 gün içinde yapılmalıdır"
  // Şirket bilgileri (footer'da görünür)
  companyName  String?  // şirket yasal adı
  companyAddress String?
  companyPhone String?
  companyEmail String?
  companyWeb   String?
  taxNumber    String?
  taxOffice    String?
  // Banka bilgileri (opsiyonel)
  showBankInfo Boolean  @default(true)
  bankInfo     String?  // JSON: [{bankName, iban, accountHolder}]
  // İmza
  showSignature Boolean @default(false)
  signatureText String? // "Yetkili İmza"
  // Sayfa ayarları
  pageSize     String   @default("A4") // A4 | Letter
  marginMm     Int      @default(15)
  // Diğer
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
