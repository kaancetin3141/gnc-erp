generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                  String               @id @default(cuid())
  name                String
  plan                String               @default("business")
  defaultCurrency     String               @default("TRY")
  country             String               @default("TR")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  activities          Activity[]
  auditLogs           AuditLog[]
  cafes               Cafe[]
  customers           Customer[]
  deals               Deal[]
  expenses            Expense[]
  exportDocs          ExportDoc[]
  invoices            Invoice[]
  invoiceTemplate     InvoiceTemplate?
  irsaliyeler         Irsaliye[]
  leads               Lead[]
  mapsSearch          MapsSearch[]
  markets             Market[]
  messages            Message[]
  messageTemplates    MessageTemplate[]
  orders              Order[]
  products            Product[]
  productionItems     ProductionItem[]
  quotes              Quote[]
  residents           Resident[]
  serviceProviders    ServiceProvider[]
  sites               Site[]
  socialAccounts      SocialAccount[]
  socialInboxMessages SocialInboxMessage[]
  socialPosts         SocialPost[]
  tags                Tag[]
  tasks               Task[]
  settings            TenantSetting[]
  users               User[]
  whatsappMessages    WhatsAppMessage[]
}

model TenantSetting {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  value     String
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

model User {
  id               String       @id @default(cuid())
  tenantId         String
  email            String       @unique
  name             String
  role             String       @default("rep")
  permissions      String       @default("[]")
  managerId        String?
  status           String       @default("active")
  phone            String?
  avatarUrl        String?
  title            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  employeeCode     String?      @unique
  passwordHash     String?
  activities       Activity[]   @relation("ActivityPerformer")
  auditLogs        AuditLog[]   @relation("AuditActor")
  ownedCustomers   Customer[]   @relation("CustomerOwner")
  ownedDeals       Deal[]       @relation("DealOwner")
  ownedLeads       Lead[]       @relation("LeadOwner")
  mapsSearches     MapsSearch[]
  receivedMessages Message[]    @relation("MessageReceiver")
  sentMessages     Message[]    @relation("MessageSender")
  notes            Note[]
  sessions         Session[]
  socialPosts      SocialPost[]
  assignedTasks    Task[]       @relation("TaskAssignee")
  manager          User?        @relation("ManagerHierarchy", fields: [managerId], references: [id])
  subordinates     User[]       @relation("ManagerHierarchy")
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Message {
  id         String   @id @default(cuid())
  tenantId   String
  senderId   String
  receiverId String?
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  receiver   User?    @relation("MessageReceiver", fields: [receiverId], references: [id])
  sender     User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, receiverId, isRead])
  @@index([tenantId, senderId, createdAt])
}

model Customer {
  id               String            @id @default(cuid())
  tenantId         String
  name             String
  sector           String            @default("Diğer")
  segment          String            @default("standart")
  ownerId          String?
  source           String            @default("manuel")
  address          String?
  city             String?
  district         String?
  country          String            @default("TR")
  lat              Float?
  lng              Float?
  placeId          String?
  phone            String?
  email            String?
  web              String?
  taxNumber        String?
  logo             String?
  customerType     String            @default("musteri")
  status           String            @default("aktif")
  tags             String            @default("[]")
  kvkkConsent      Boolean           @default(false)
  kvkkConsentAt    DateTime?
  annualRevenue    Float?
  employeeCount    Int?
  lastActivityAt   DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  activities       Activity[]
  attachments      Attachment[]
  contacts         Contact[]
  owner            User?             @relation("CustomerOwner", fields: [ownerId], references: [id])
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deals            Deal[]
  exportDocs       ExportDoc[]
  invoices         Invoice[]
  irsaliyeler      Irsaliye[]
  leads            Lead[]            @relation("LeadConvertedTo")
  notes            Note[]
  orders           Order[]
  quotes           Quote[]
  tasks            Task[]
  whatsappMessages WhatsAppMessage[]
}

model WhatsAppMessage {
  id            String    @id @default(cuid())
  tenantId      String
  customerId    String?
  customerName  String?
  phone         String
  title         String?
  body          String
  contextType   String    @default("serbest")
  contextId     String?
  contextNo     String?
  amount        Float?
  currency      String?
  status        String    @default("kuyrukta")
  channel       String    @default("wa.me")
  sentAt        DateTime?
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  customer      Customer? @relation(fields: [customerId], references: [id])
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, contextType])
  @@index([customerId])
}

model Contact {
  id         String   @id @default(cuid())
  customerId String
  name       String
  position   String?
  email      String?
  phone      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  photo      String?
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Lead {
  id                  String      @id @default(cuid())
  tenantId            String
  name                String
  placeId             String?
  category            String?
  address             String?
  city                String?
  country             String      @default("TR")
  lat                 Float?
  lng                 Float?
  phone               String?
  web                 String?
  email               String?
  rating              Float?
  reviewCount         Int?
  ownerId             String?
  source              String      @default("google_maps")
  status              String      @default("yeni")
  convertedCustomerId String?
  notes               String      @default("[]")
  mapsSearchId        String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  district            String?
  activities          Activity[]
  mapsSearch          MapsSearch? @relation(fields: [mapsSearchId], references: [id])
  convertedCustomer   Customer?   @relation("LeadConvertedTo", fields: [convertedCustomerId], references: [id])
  owner               User?       @relation("LeadOwner", fields: [ownerId], references: [id])
  tenant              Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model MapsSearch {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String?
  query         String
  city          String?
  country       String   @default("TR")
  radius        Int?
  resultCount   Int      @default(0)
  importedCount Int      @default(0)
  createdAt     DateTime @default(now())
  leads         Lead[]
  user          User?    @relation(fields: [userId], references: [id])
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Deal {
  id                String     @id @default(cuid())
  tenantId          String
  title             String
  customerId        String
  value             Float      @default(0)
  currency          String     @default("TRY")
  stage             String     @default("yeni")
  probability       Int        @default(10)
  expectedCloseDate DateTime?
  ownerId           String?
  lossReason        String?
  lossNote          String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  activities        Activity[]
  owner             User?      @relation("DealOwner", fields: [ownerId], references: [id])
  customer          Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Activity {
  id          String    @id @default(cuid())
  tenantId    String
  customerId  String?
  leadId      String?
  dealId      String?
  type        String
  subject     String
  detail      String?
  date        DateTime  @default(now())
  durationMin Int       @default(0)
  outcome     String?
  userId      String?
  createdAt   DateTime  @default(now())
  user        User?     @relation("ActivityPerformer", fields: [userId], references: [id])
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Note {
  id         String   @id @default(cuid())
  customerId String
  userId     String?
  content    String
  isPinned   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User?    @relation(fields: [userId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Task {
  id            String    @id @default(cuid())
  tenantId      String
  title         String
  description   String?
  dueDate       DateTime
  assigneeId    String?
  customerId    String?
  priority      String    @default("orta")
  reminderTime  String?
  status        String    @default("acik")
  autoGenerated Boolean   @default(false)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  customer      Customer? @relation(fields: [customerId], references: [id])
  assignee      User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Attachment {
  id         String   @id @default(cuid())
  customerId String
  fileName   String
  fileType   String
  fileSize   Int
  url        String
  uploadedBy String?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Tag {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  color     String   @default("gray")
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  actorId   String?
  action    String
  entity    String
  entityId  String?
  before    String?
  after     String?
  ip        String?
  createdAt DateTime @default(now())
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Product {
  id              String           @id @default(cuid())
  tenantId        String
  name            String
  sku             String?
  description     String?
  price           Float            @default(0)
  currency        String           @default("TRY")
  taxRate         Float            @default(20)
  stock           Int              @default(0)
  minStock        Int              @default(0)
  unit            String           @default("adet")
  category        String?
  photo           String?
  weight          Float?
  weightUnit      String           @default("kg")
  packagingWeight Float?
  packagingType   String?
  paletType       String?
  paletCount      Int?
  carrier         String?
  trackingNumber  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  color           String?
  barcodes        Barcode[]
  invoiceLines    InvoiceLine[]
  irsaliyeLines   IrsaliyeLine[]
  marketSaleItems MarketSaleItem[]
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productionItems ProductionItem[]
  purchaseItems   PurchaseItem[]
  quoteLines      QuoteLine[]
  shelfItems      ShelfItem[]
  stockCountItems StockCountItem[]
  stockMovements  StockMovement[]
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  quantity  Int
  type      String
  reason    String?
  refType   String?
  refId     String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Quote {
  id         String      @id @default(cuid())
  tenantId   String
  customerId String
  number     String
  status     String      @default("taslak")
  isProforma Boolean     @default(false)
  subtotal   Float       @default(0)
  taxTotal   Float       @default(0)
  total      Float       @default(0)
  currency   String      @default("TRY")
  issueDate  DateTime    @default(now())
  validUntil DateTime?
  invoiceId  String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  order      Order?
  invoice    Invoice?    @relation("QuoteInvoice", fields: [invoiceId], references: [id])
  customer   Customer    @relation(fields: [customerId], references: [id])
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines      QuoteLine[]
}

model QuoteLine {
  id            String   @id @default(cuid())
  quoteId       String
  productId     String?
  description   String
  qty           Float    @default(1)
  unitPrice     Float    @default(0)
  taxRate       Float    @default(20)
  lineTotal     Float    @default(0)
  color         String?
  totalWeight   Float?
  weightPerUnit Float?
  weightUnit    String?
  product       Product? @relation(fields: [productId], references: [id])
  quote         Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model Invoice {
  id              String        @id @default(cuid())
  tenantId        String
  customerId      String
  number          String
  status          String        @default("odeme_bekliyor")
  subtotal        Float         @default(0)
  taxTotal        Float         @default(0)
  total           Float         @default(0)
  currency        String        @default("TRY")
  issueDate       DateTime      @default(now())
  dueDate         DateTime?
  paidDate        DateTime?
  packingListNo   String?
  packingListDate DateTime?
  dispatchNo      String?
  dispatchDate    DateTime?
  orderId         String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  order           Order?        @relation(fields: [orderId], references: [id])
  customer        Customer      @relation(fields: [customerId], references: [id])
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines           InvoiceLine[]
  fromQuotes      Quote[]       @relation("QuoteInvoice")
}

model InvoiceLine {
  id            String   @id @default(cuid())
  invoiceId     String
  productId     String?
  description   String
  qty           Float    @default(1)
  unitPrice     Float    @default(0)
  taxRate       Float    @default(20)
  lineTotal     Float    @default(0)
  color         String?
  totalWeight   Float?
  weightPerUnit Float?
  weightUnit    String?
  product       Product? @relation(fields: [productId], references: [id])
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Order {
  id               String              @id @default(cuid())
  tenantId         String
  customerId       String
  quoteId          String?             @unique
  number           String
  status           String              @default("hazirlaniyor")
  totalAmount      Float               @default(0)
  currency         String              @default("TRY")
  orderDate        DateTime            @default(now())
  expectedDelivery DateTime?
  deliveredAt      DateTime?
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  exportDocs       ExportDoc[]
  invoice          Invoice?
  irsaliyeler      Irsaliye[]
  quote            Quote?              @relation(fields: [quoteId], references: [id])
  customer         Customer            @relation(fields: [customerId], references: [id])
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trackingSteps    OrderTrackingStep[]
  productionItems  ProductionItem[]
}

model ExportDoc {
  id                 String   @id @default(cuid())
  tenantId           String
  orderId            String
  customerId         String
  type               String
  number             String
  status             String   @default("hazir")
  issueDate          DateTime @default(now())
  transportMode      String?
  incoterms          String?
  destinationCountry String?
  portOfLoading      String?
  portOfDischarge    String?
  vesselName         String?
  containerNo        String?
  vehiclePlate       String?
  carrierName        String?
  insuranceCompany   String?
  policyAmount       Float?
  policyCurrency     String?
  notes              String?
  createdById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  customer           Customer @relation(fields: [customerId], references: [id])
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, number])
  @@index([tenantId, type])
  @@index([tenantId, orderId])
  @@index([tenantId, status])
}

model OrderTrackingStep {
  id        String   @id @default(cuid())
  orderId   String
  step      String
  note      String?
  userId    String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model MessageTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  type      String   @default("whatsapp")
  category  String   @default("genel")
  subject   String?
  content   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, type])
}

model ProductionItem {
  id          String    @id @default(cuid())
  tenantId    String
  orderId     String
  productId   String?
  description String
  qty         Float     @default(1)
  status      String    @default("bekliyor")
  producedAt  DateTime?
  producedBy  String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  product     Product?  @relation(fields: [productId], references: [id])
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

model Irsaliye {
  id                   String         @id @default(cuid())
  tenantId             String
  orderId              String?
  customerId           String
  number               String
  date                 DateTime       @default(now())
  status               String         @default("taslak")
  totalNetWeight       Float?
  totalPackagingWeight Float?
  palletWeight         Float?
  totalGrossWeight     Float?
  palletCount          Int?
  palletType           String?
  shippingAddress      String?
  carrier              String?
  trackingNo           String?
  notes                String?
  createdById          String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deliveredAt          DateTime?
  customer             Customer       @relation(fields: [customerId], references: [id])
  order                Order?         @relation(fields: [orderId], references: [id])
  tenant               Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines                IrsaliyeLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model IrsaliyeLine {
  id            String   @id @default(cuid())
  irsaliyeId    String
  productId     String?
  description   String
  qty           Float    @default(1)
  unit          String   @default("adet")
  weightPerUnit Float?
  totalWeight   Float?
  notes         String?
  product       Product? @relation(fields: [productId], references: [id])
  irsaliye      Irsaliye @relation(fields: [irsaliyeId], references: [id], onDelete: Cascade)

  @@index([irsaliyeId])
}

model Cafe {
  id             String         @id @default(cuid())
  tenantId       String
  name           String
  address        String?
  phone          String?
  tableCount     Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cafeOrders     CafeOrder[]
  tables         CafeTable[]
  menuCategories MenuCategory[]
}

model CafeTable {
  id        String      @id @default(cuid())
  cafeId    String
  number    String
  shape     String      @default("square")
  x         Float       @default(50)
  y         Float       @default(50)
  width     Float       @default(10)
  height    Float       @default(10)
  capacity  Int         @default(4)
  status    String      @default("bos")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  orders    CafeOrder[]
  cafe      Cafe        @relation(fields: [cafeId], references: [id], onDelete: Cascade)
}

model MenuCategory {
  id        String     @id @default(cuid())
  cafeId    String
  name      String
  icon      String?
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  cafe      Cafe       @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  items     MenuItem[]
}

model MenuItem {
  id          String          @id @default(cuid())
  categoryId  String
  name        String
  description String?
  price       Float           @default(0)
  currency    String          @default("TRY")
  photo       String?
  isAvailable Boolean         @default(true)
  prepTime    Int             @default(10)
  station     String          @default("kitchen")
  recipe      String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  orderItems  CafeOrderItem[]
  category    MenuCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model CafeOrder {
  id           String          @id @default(cuid())
  cafeId       String
  tableId      String?
  number       String
  status       String          @default("acik")
  type         String          @default("dine_in")
  customerName String?
  subtotal     Float           @default(0)
  taxTotal     Float           @default(0)
  total        Float           @default(0)
  notes        String?
  createdById  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  table        CafeTable?      @relation(fields: [tableId], references: [id])
  cafe         Cafe            @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  items        CafeOrderItem[]
  payments     CafePayment[]
}

model CafeOrderItem {
  id         String    @id @default(cuid())
  orderId    String
  menuItemId String?
  name       String
  qty        Int       @default(1)
  unitPrice  Float     @default(0)
  status     String    @default("bekliyor")
  notes      String?
  station    String    @default("kitchen")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id])
  order      CafeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model CafePayment {
  id        String    @id @default(cuid())
  orderId   String
  amount    Float
  method    String    @default("cash")
  status    String    @default("tamamlandi")
  createdAt DateTime  @default(now())
  order     CafeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Market {
  id          String       @id @default(cuid())
  tenantId    String
  name        String
  address     String?
  phone       String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  barcodes    Barcode[]
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales       MarketSale[]
  posShifts   PosShift[]
  purchases   Purchase[]
  shelves     Shelf[]
  stockCounts StockCount[]
}

model Shelf {
  id        String      @id @default(cuid())
  marketId  String
  code      String
  name      String?
  aisle     String?
  createdAt DateTime    @default(now())
  market    Market      @relation(fields: [marketId], references: [id], onDelete: Cascade)
  items     ShelfItem[]
}

model ShelfItem {
  id            String  @id @default(cuid())
  shelfId       String
  productId     String
  qty           Int     @default(0)
  minDisplayQty Int     @default(2)
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  shelf         Shelf   @relation(fields: [shelfId], references: [id], onDelete: Cascade)
}

model Barcode {
  id        String   @id @default(cuid())
  marketId  String?
  productId String
  code      String   @unique
  type      String   @default("ean13")
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  market    Market?  @relation(fields: [marketId], references: [id])
}

model StockCount {
  id          String           @id @default(cuid())
  marketId    String
  number      String
  status      String           @default("taslak")
  startDate   DateTime         @default(now())
  endDate     DateTime?
  notes       String?
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  market      Market           @relation(fields: [marketId], references: [id], onDelete: Cascade)
  items       StockCountItem[]
}

model StockCountItem {
  id           String     @id @default(cuid())
  stockCountId String
  productId    String
  expectedQty  Int        @default(0)
  countedQty   Int?
  difference   Int?
  notes        String?
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockCount   StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
}

model PosShift {
  id           String       @id @default(cuid())
  marketId     String
  userId       String
  number       String
  status       String       @default("acik")
  openingCash  Float        @default(0)
  closingCash  Float?
  expectedCash Float?
  difference   Float?
  openingTime  DateTime     @default(now())
  closingTime  DateTime?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sales        MarketSale[]
  market       Market       @relation(fields: [marketId], references: [id], onDelete: Cascade)
}

model MarketSale {
  id            String           @id @default(cuid())
  marketId      String
  posShiftId    String?
  number        String
  type          String           @default("satis")
  status        String           @default("tamamlandi")
  subtotal      Float            @default(0)
  taxTotal      Float            @default(0)
  discount      Float            @default(0)
  total         Float            @default(0)
  paymentMethod String           @default("cash")
  cashAmount    Float            @default(0)
  cardAmount    Float            @default(0)
  customerName  String?
  userId        String?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  returns       MarketReturn[]
  posShift      PosShift?        @relation(fields: [posShiftId], references: [id])
  market        Market           @relation(fields: [marketId], references: [id], onDelete: Cascade)
  items         MarketSaleItem[]
}

model MarketSaleItem {
  id        String     @id @default(cuid())
  saleId    String
  productId String?
  barcode   String?
  name      String
  qty       Float      @default(1)
  unitPrice Float      @default(0)
  taxRate   Float      @default(20)
  discount  Float      @default(0)
  lineTotal Float      @default(0)
  product   Product?   @relation(fields: [productId], references: [id])
  sale      MarketSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model MarketReturn {
  id          String     @id @default(cuid())
  saleId      String
  reason      String
  totalAmount Float      @default(0)
  status      String     @default("tamamlandi")
  userId      String?
  createdAt   DateTime   @default(now())
  sale        MarketSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model Purchase {
  id          String         @id @default(cuid())
  marketId    String
  number      String
  supplier    String?
  invoiceNo   String?
  status      String         @default("bekliyor")
  totalAmount Float          @default(0)
  notes       String?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  market      Market         @relation(fields: [marketId], references: [id], onDelete: Cascade)
  items       PurchaseItem[]
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  productId  String?
  barcode    String?
  name       String
  qty        Float    @default(1)
  unitPrice  Float    @default(0)
  lineTotal  Float    @default(0)
  accepted   Boolean  @default(false)
  product    Product? @relation(fields: [productId], references: [id])
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String   @id @default(cuid())
  tenantId    String
  category    String
  description String
  amount      Float
  currency    String   @default("TRY")
  date        DateTime @default(now())
  recurring   String?
  vendor      String?
  invoiceNo   String?
  status      String   @default("odendi")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@index([tenantId, category])
}

model ServiceProvider {
  id           String                @id @default(cuid())
  tenantId     String
  name         String
  slug         String?               @unique
  type         String                @default("berber")
  address      String?
  city         String?
  district     String?
  phone        String?
  email        String?
  photo        String?
  workingHours String                @default("{}")
  autoApprove  Boolean               @default(true)
  isActive     Boolean               @default(true)
  lat          Float?  // coğrafi enlem (OSM Nominatim ile doldurulur)
  lng          Float?  // coğrafi boylam
  geoCheckedAt DateTime? // son coğrafi kodlama zamanı
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  appointments Appointment[]
  customers    AppointmentCustomer[]
  services     Service[]
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff        Staff[]
  timeOffs     StaffTimeOff[]
}

// Global sistem ayarları (tenant-bağımsız): base_domain vb.
model SystemSetting {
  key       String   @id // "base_domain" → "gncrm.com"
  value     String
  updatedAt DateTime @updatedAt
}

model Staff {
  id            String          @id @default(cuid())
  providerId    String
  name          String
  title         String?
  photo         String?
  phone         String?
  bio           String?
  isActive      Boolean         @default(true)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  appointments  Appointment[]
  provider      ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  staffServices StaffService[]
  timeOffs      StaffTimeOff[]
}

model StaffTimeOff {
  id         String          @id @default(cuid())
  providerId String
  staffId    String
  date       DateTime
  isFullDay  Boolean         @default(true)
  startTime  String?
  endTime    String?
  reason     String?
  createdAt  DateTime        @default(now())
  staff      Staff           @relation(fields: [staffId], references: [id], onDelete: Cascade)
  provider   ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, date])
  @@index([staffId, date])
}

model Service {
  id            String          @id @default(cuid())
  providerId    String
  name          String
  description   String?
  duration      Int             @default(30)
  price         Float           @default(0)
  currency      String          @default("TRY")
  category      String?
  photo         String?
  isActive      Boolean         @default(true)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  appointments  Appointment[]
  provider      ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  staffServices StaffService[]
}

model StaffService {
  id        String  @id @default(cuid())
  staffId   String
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
}

model Appointment {
  id            String               @id @default(cuid())
  providerId    String
  customerId    String?
  staffId       String?
  serviceId     String?
  customerName  String
  customerPhone String
  customerEmail String?
  customerNote  String?
  date          DateTime
  endTime       DateTime?
  status        String               @default("beklemede")
  price         Float                @default(0)
  notes         String?
  source        String               @default("web")
  reminderSent  Boolean              @default(false)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  service       Service?             @relation(fields: [serviceId], references: [id])
  staff         Staff?               @relation(fields: [staffId], references: [id])
  customer      AppointmentCustomer? @relation(fields: [customerId], references: [id])
  provider      ServiceProvider      @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, date])
  @@index([staffId, date])
  @@index([status])
  @@index([customerId])
}

model AppointmentCustomer {
  id           String          @id @default(cuid())
  providerId   String
  name         String
  phone        String
  phoneDigits  String
  email        String?
  address      String?
  notes        String?
  tags         String?
  birthday     String?
  isBlocked    Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  appointments Appointment[]
  provider     ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, phoneDigits])
  @@index([providerId, name])
}

model Site {
  id               String         @id @default(cuid())
  tenantId         String
  name             String
  address          String?
  city             String?
  district         String?
  phone            String?
  email            String?
  managerName      String?
  dueDay           Int            @default(5)
  defaultDueAmount Float          @default(0)
  currency         String         @default("TRY")
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  announcements    Announcement[]
  apartments       Apartment[]
  blocks           Block[]
  complaints       Complaint[]
  dues             Dues[]
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteStaff        SiteStaff[]
}

model Block {
  id         String      @id @default(cuid())
  siteId     String
  name       String
  floors     Int         @default(5)
  createdAt  DateTime    @default(now())
  apartments Apartment[]
  site       Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model Apartment {
  id         String    @id @default(cuid())
  blockId    String
  siteId     String
  number     String
  floor      Int?
  type       String    @default("daire")
  area       Float?
  residentId String?   @unique
  createdAt  DateTime  @default(now())
  resident   Resident? @relation(fields: [residentId], references: [id])
  site       Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  block      Block     @relation(fields: [blockId], references: [id], onDelete: Cascade)
  dues       Dues[]
}

model Resident {
  id           String            @id @default(cuid())
  tenantId     String
  siteId       String
  name         String
  email        String?
  phone        String?
  password     String?
  type         String            @default("mal_sahibi")
  isOwner      Boolean           @default(true)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  leaseEndDate DateTime?
  moveInDate   DateTime?
  notes        String?
  tcKimlikNo   String?
  passwordHash String?
  apartment    Apartment?
  complaints   Complaint[]
  dues         Dues[]
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages     ResidentMessage[]
}

model Dues {
  id               String    @id @default(cuid())
  siteId           String
  apartmentId      String
  residentId       String?
  month            Int
  year             Int
  amount           Float
  currency         String    @default("TRY")
  dueDate          DateTime
  status           String    @default("odenmedi")
  paidDate         DateTime?
  paidAmount       Float?
  paymentMethod    String?
  lateFee          Float     @default(0)
  lateFeeAppliedAt DateTime?
  reminderSent     Boolean   @default(false)
  reminderSentAt   DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  resident         Resident? @relation(fields: [residentId], references: [id])
  apartment        Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  site             Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, year, month])
  @@index([status])
}

model SiteStaff {
  id        String    @id @default(cuid())
  siteId    String
  name      String
  role      String    @default("kapici")
  phone     String?
  photo     String?
  salary    Float?
  startDate DateTime?
  isActive  Boolean   @default(true)
  notes     String?
  createdAt DateTime  @default(now())
  site      Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          String    @id @default(cuid())
  siteId      String
  title       String
  content     String
  type        String    @default("genel")
  isPinned    Boolean   @default(false)
  publishDate DateTime  @default(now())
  expiryDate  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model Complaint {
  id          String    @id @default(cuid())
  siteId      String
  residentId  String?
  title       String
  description String
  category    String    @default("diger")
  status      String    @default("acik")
  priority    String    @default("normal")
  response    String?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resident    Resident? @relation(fields: [residentId], references: [id])
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model ResidentMessage {
  id         String   @id @default(cuid())
  residentId String
  subject    String
  content    String
  response   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
}

model SocialAccount {
  id             String               @id @default(cuid())
  tenantId       String
  platform       String
  handle         String
  displayName    String?
  avatarUrl      String?
  bio            String?
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  apiKey         String?
  apiSecret      String?
  username       String?
  authMethod     String               @default("mock")
  scopes         String?
  profileData    String?
  followerCount  Int                  @default(0)
  followingCount Int                  @default(0)
  postCount      Int                  @default(0)
  isVerified     Boolean              @default(false)
  isActive       Boolean              @default(true)
  connectedAt    DateTime             @default(now())
  lastSyncedAt   DateTime?
  disconnectedAt DateTime?
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inboxMessages  SocialInboxMessage[]
  posts          SocialPostTarget[]

  @@unique([tenantId, platform, handle])
  @@index([tenantId, platform])
}

model SocialPost {
  id                 String                @id @default(cuid())
  tenantId           String
  authorId           String
  content            String
  mediaUrls          String                @default("[]")
  mediaType          String                @default("text")
  linkUrl            String?
  linkPreview        String?
  hashtags           String?
  mentions           String?
  platforms          String                @default("[]")
  perPlatformContent String?               @default("{}")
  status             String                @default("taslak")
  scheduledAt        DateTime?
  publishedAt        DateTime?
  campaignName       String?
  notes              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  author             User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  analytics          SocialPostAnalytics[]
  targets            SocialPostTarget[]

  @@index([tenantId, status])
  @@index([tenantId, scheduledAt])
  @@index([authorId])
}

model SocialPostTarget {
  id           String        @id @default(cuid())
  postId       String
  accountId    String
  platform     String
  externalId   String?
  externalUrl  String?
  status       String        @default("bekliyor")
  errorMessage String?
  publishedAt  DateTime?
  likes        Int           @default(0)
  comments     Int           @default(0)
  shares       Int           @default(0)
  views        Int           @default(0)
  reach        Int           @default(0)
  impressions  Int           @default(0)
  lastSyncedAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  account      SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  post         SocialPost    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, accountId])
  @@index([status])
}

model SocialInboxMessage {
  id                String        @id @default(cuid())
  tenantId          String
  accountId         String
  platform          String
  senderName        String
  senderHandle      String?
  senderAvatar      String?
  type              String        @default("dm")
  content           String
  mediaUrls         String?
  parentId          String?
  postExternalId    String?
  postUrl           String?
  isRead            Boolean       @default(false)
  isReplied         Boolean       @default(false)
  replyText         String?
  repliedAt         DateTime?
  priority          String        @default("normal")
  tags              String?
  externalCreatedAt DateTime?
  receivedAt        DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  account           SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isRead])
  @@index([accountId, receivedAt])
}

model SocialPostAnalytics {
  id            String     @id @default(cuid())
  postId        String
  targetId      String?
  platform      String
  date          DateTime
  likes         Int        @default(0)
  comments      Int        @default(0)
  shares        Int        @default(0)
  views         Int        @default(0)
  reach         Int        @default(0)
  impressions   Int        @default(0)
  profileClicks Int        @default(0)
  demographics  String?
  createdAt     DateTime   @default(now())
  post          SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, date])
  @@index([platform, date])
}

model InvoiceTemplate {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  logoUrl        String?
  logoPosition   String   @default("top-left")
  primaryColor   String   @default("#10b981")
  accentColor    String   @default("#0d9488")
  textColor      String   @default("#000000")
  fontFamily     String   @default("Arial, sans-serif")
  fontSize       Int      @default(12)
  headerText     String?
  footerText     String?
  companyName    String?
  companyAddress String?
  companyPhone   String?
  companyEmail   String?
  companyWeb     String?
  taxNumber      String?
  taxOffice      String?
  showBankInfo   Boolean  @default(true)
  bankInfo       String?
  showSignature  Boolean  @default(false)
  signatureText  String?
  pageSize       String   @default("A4")
  marginMm       Int      @default(15)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
