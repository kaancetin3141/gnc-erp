[Unit]
Description=KaloriAI — AI Kalori ve Beslenme Takip Uygulaması (port 3004, GNC sistemine uyarlanmış)
After=network.target

# UYARLAMA NOTU:
# Orijinal dosya: KaloriAI deposu scripts/deploy/kaloriai.service (değişmeden saklandı)
# Farklar: PORT 3000→3004, yollar /var/www/my-project/mini-services/kaloriai,
# User= proje sahibi kullanıcının adıyla dinamik (server-setup.sh doldurur).

[Service]
Type=simple
User=__KALORIAI_USER__
Group=__KALORIAI_USER__
WorkingDirectory=/var/www/my-project/mini-services/kaloriai
EnvironmentFile=/var/www/my-project/mini-services/kaloriai/.env
Environment=NODE_ENV=production
Environment=PORT=3004
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/local/bin/bun .next/standalone/server.js
Restart=always
RestartSec=5

# Düşük RAM'li VDS için makul kaynak sınırları
MemoryMax=700M
MemoryHigh=500M

# Çekirdek güvenlik sertleştirmesi
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/www/my-project/mini-services/kaloriai/db /var/www/my-project/mini-services/kaloriai/upload

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kaloriai

[Install]
WantedBy=multi-user.target
