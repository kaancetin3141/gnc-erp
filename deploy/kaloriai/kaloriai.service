[Unit]
Description=KaloriAI — AI Kalori ve Beslenme Takip Uygulaması
After=network.target

[Service]
Type=simple
User=kaloriai
Group=kaloriai
WorkingDirectory=/home/kaloriai/KaloriAI
EnvironmentFile=/home/kaloriai/KaloriAI/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/home/kaloriai/.bun/bin/bun .next/standalone/server.js
Restart=always
RestartSec=5

# Düşük RAM'li VDS için makul kaynak sınırları
MemoryMax=700M
MemoryHigh=500M

# Çekirdek güvenlik sertleştirmesi
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/kaloriai/KaloriAI/db /home/kaloriai/KaloriAI/upload

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kaloriai

[Install]
WantedBy=multi-user.target
