{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GNC CRM",
  "version": "1.0.0",
  "identifier": "com.gnccrm.desktop",
  "build": {
    "beforeBuildCommand": "bun run build:web",
    "frontendDist": "../.next/standalone",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run dev"
  },
  "app": {
    "windows": [
      {
        "title": "GNC CRM — Satış Süperapp",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "theme": "System"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["../**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 GNC CRM",
    "category": "Business",
    "shortDescription": "KOBİ satış süperapp",
    "longDescription": "KOBİ satış ekipleri için CRM + ERP + Sosyal Medya süperapp — tek platformda.",
    "publisher": "GNC CRM",
    "homepage": "https://gnccrm.app",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": ["tr-TR", "en-US"]
      },
      "nsis": {
        "languages": ["Turkish", "English"]
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "iOS": {
      "frameworks": []
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
